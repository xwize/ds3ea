{
	"version": 6,
	"cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"DS3EA_RESHADE_DIR": "$env{DS3EA_RESHADE_DIR}"
			},
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		},
		{
			"name": "vs",
			"displayName": "Visual Studio 2026 (x64, multi-config)",
			"description": "Works from any shell; no developer prompt needed",
			"inherits": "base",
			"generator": "Visual Studio 18 2026",
			"architecture": { "value": "x64", "strategy": "set" }
		},
		{
			"name": "ninja-base",
			"hidden": true,
			"inherits": "base",
			"generator": "Ninja",
			"architecture": { "value": "x64", "strategy": "external" },
			"toolset": { "value": "host=x64", "strategy": "external" },
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "Windows" ] }
			}
		},
		{
			"name": "ninja-debug",
			"displayName": "Ninja Debug (x64 MSVC)",
			"description": "For IDEs that provide the MSVC environment (Visual Studio, CLion, VS Code)",
			"inherits": "ninja-base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},
		{
			"name": "ninja-release",
			"displayName": "Ninja Release (x64 MSVC)",
			"description": "For IDEs that provide the MSVC environment (Visual Studio, CLion, VS Code)",
			"inherits": "ninja-base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "clang-base",
			"hidden": true,
			"inherits": "ninja-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_CXX_COMPILER": "clang-cl",
				"DS3EA_CLANG_TIDY": "OFF"
			}
		},
		{
			"name": "clang-debug",
			"displayName": "Ninja Debug (x64 clang-cl)",
			"description": "Second compiler, for its warnings. Needs the MSVC environment like the ninja-* presets",
			"inherits": "clang-base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},
		{
			"name": "clang-release",
			"displayName": "Ninja Release (x64 clang-cl)",
			"description": "Second compiler, for its warnings. Needs the MSVC environment like the ninja-* presets",
			"inherits": "clang-base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "clang-sanitize",
			"displayName": "Ninja Sanitize (x64 clang-cl, ASan + UBSan)",
			"description": "Unit tests under AddressSanitizer and UndefinedBehaviorSanitizer. The add-on DLL isn't built",
			"inherits": "clang-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"DS3EA_SANITIZE": "ON"
			}
		}
	],
	"buildPresets": [
		{ "name": "vs-debug", "displayName": "Debug", "configurePreset": "vs", "configuration": "Debug" },
		{ "name": "vs-release", "displayName": "Release", "configurePreset": "vs", "configuration": "Release" },
		{ "name": "ninja-debug", "displayName": "Debug", "configurePreset": "ninja-debug" },
		{ "name": "ninja-release", "displayName": "Release", "configurePreset": "ninja-release" },
		{ "name": "clang-debug", "displayName": "Debug", "configurePreset": "clang-debug" },
		{ "name": "clang-release", "displayName": "Release", "configurePreset": "clang-release" },
		{ "name": "clang-sanitize", "displayName": "Sanitize", "configurePreset": "clang-sanitize" }
	],
	"testPresets": [
		{
			"name": "test-base",
			"hidden": true,
			"output": { "outputOnFailure": true }
		},
		{
			"name": "vs-debug",
			"inherits": "test-base",
			"configurePreset": "vs",
			"configuration": "Debug"
		},
		{
			"name": "vs-release",
			"inherits": "test-base",
			"configurePreset": "vs",
			"configuration": "Release"
		},
		{ "name": "ninja-debug", "inherits": "test-base", "configurePreset": "ninja-debug" },
		{ "name": "ninja-release", "inherits": "test-base", "configurePreset": "ninja-release" },
		{ "name": "clang-debug", "inherits": "test-base", "configurePreset": "clang-debug" },
		{ "name": "clang-release", "inherits": "test-base", "configurePreset": "clang-release" },
		{ "name": "clang-sanitize", "inherits": "test-base", "configurePreset": "clang-sanitize" }
	]
}
